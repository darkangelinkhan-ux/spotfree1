# --- Resend (transactional email) ---
# Get your key at https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
# --- Supabase (auth: login / signup) ---
# Get these from your Supabase project's Settings > API page.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: enables auto-confirmed signups (no "confirm your email" step) via the
# Supabase Admin API. Never expose this key to the browser / commit it to git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: used to build the "Go To Login" link in the welcome email.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
